# Скопируйте в .env и заполните под свой контур: cp .env.example .env

# Обязательно: секретный ключ Django.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False

# Список разрешённых Host через запятую. "*" — для доверенной внутренней сети.
DJANGO_ALLOWED_HOSTS=*
# Доверенные origin для CSRF, с указанием схемы: https://warehouse.example.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# Путь к БД SQLite внутри контейнера (в compose переопределяется на volume).
DJANGO_DB_PATH=/app/dbdata/db.sqlite3
DJANGO_LOG_LEVEL=INFO

# Наружный порт сервиса на хосте.
HOST_PORT=8081

# Gunicorn: один worker (см. gunicorn.conf.py), несколько потоков.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120

# Включайте только при работе за TLS-прокси (HTTPS):
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
